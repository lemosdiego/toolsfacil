# Copie para .env.local e preencha. Variáveis NEXT_PUBLIC_* entram na página
# durante o build: depois de mudar, é preciso publicar de novo.

# URL pública do site (ex.: https://exemplo.com.br). Obrigatória em produção;
# opcional em desenvolvimento. Passa a ser usada na fase 06 (SEO).
NEXT_PUBLIC_SITE_URL=

# ID do publisher do AdSense (ca-pub-...). Sem ele, nenhum anúncio aparece
# (padrão em dev e nos testes). Preencher só depois da aprovação (fase 16).
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
