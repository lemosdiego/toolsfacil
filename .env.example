# Copie para .env.local e preencha. Variáveis NEXT_PUBLIC_* entram na página
# durante o build: depois de mudar, é preciso publicar de novo.

# URL pública do site (ex.: https://exemplo.com.br), sem barra no final. Base
# do canonical, do sitemap e do Open Graph. Obrigatória no build de produção
# (pnpm build falha sem ela; localmente, http://localhost:3000 serve). Em dev,
# o padrão é http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# ID do publisher do AdSense (ca-pub-...). Sem ele, nenhum anúncio aparece
# (padrão em dev e nos testes). Preencher só depois da aprovação do AdSense.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
